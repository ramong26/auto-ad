{
  "name": "auto-ad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "discover": "node --env-file-if-exists=.env src/index.ts discover",
    "bot": "node --env-file-if-exists=.env src/index.ts bot",
    "review": "node --env-file-if-exists=.env src/index.ts review",
    "wordpress:verify": "node --env-file-if-exists=.env src/index.ts wordpress-verify",
    "site:check": "node --env-file-if-exists=.env src/site-readiness.ts",
    "mvp:test": "node --test src/mvp.test.ts",
    "draft:check": "node --test src/drafting.test.ts",
    "draft:finalize": "node --env-file-if-exists=.env src/index.ts draft-finalize",
    "draft:fail": "node --env-file-if-exists=.env src/index.ts draft-fail",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
